# Local config / secrets (never commit real credentials).
# NOTE: application-local.yaml is tracked on purpose — it holds only local
# throwaway container values for "clone and run". Real secrets go via env vars
# or an ignored application-secret*.yaml, never a committed file.
application-secret.yaml
application-secret.yml
application-*-secret.yaml
*.env
.env
*.jks
*.p12
*.pem
*.key
__pycache__/
